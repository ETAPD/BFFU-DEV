@CORP_ICON_X = 10
@CORP_NAME_X = 58
@TRUST_X     = 200
@STATUS_X    = 315

guiTypes = {

	containerWindowType = {
		name = "usa_corporate_relations_decision_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 280 }

		# ── Active contracts counter ──
		instantTextBoxType = {
			name = "active_contracts_counter"
			position = { x = @CORP_ICON_X y = 5 }
			font = "hoi_18mbs"
			text = "USA_active_contracts_counter"
			format = left
			maxHeight = 24
			maxwidth = 300
		}

		# ── Column headers (all positive y — below the category description) ──
		instantTextBoxType = {
			name = "corp_col_header"
			position = { x = @CORP_NAME_X y = 35 }
			font = "hoi_18mbs"
			text = "USA_corp_col_header"
			format = left
			maxHeight = 24
			maxwidth = 135
		}
		instantTextBoxType = {
			name = "trust_col_header"
			position = { x = @TRUST_X y = 35 }
			font = "hoi_18mbs"
			text = "USA_trust_col_header"
			format = center
			maxHeight = 24
			maxwidth = 100
		}
		instantTextBoxType = {
			name = "status_col_header"
			position = { x = @STATUS_X y = 35 }
			font = "hoi_18mbs"
			text = "USA_status_col_header"
			format = center
			maxHeight = 24
			maxwidth = 140
		}

		# ── Kaiser's Industries ──────────────────────────────────────────────
		iconType = {
			name = "kaiser_icon"
			spriteType = "GFX_corp_usa_kaiser"
			position = { x = @CORP_ICON_X y = 60 }
		}
		instantTextBoxType = {
			name = "kaiser_name"
			position = { x = @CORP_NAME_X y = 70 }
			font = "hoi_18mbs"
			text = "USA_corp_kaiser_name"
			format = left
			maxHeight = 24
			maxwidth = 135
		}
		# Tooltip: contract bonus per relations tier (hover icon or name)
		instantTextBoxType = {
			name = "kaiser_tooltip_fake"
			position = { x = @CORP_ICON_X y = 60 }
			maxwidth = 185
			maxHeight = 40
			pdx_tooltip = USA_corp_kaiser_tooltip
		}
		instantTextBoxType = {
			name = "kaiser_trust"
			position = { x = @TRUST_X y = 70 }
			font = "hoi_18mbs"
			text = "[USA_kaiser_trust_text]"
			format = center
			maxwidth = 100
