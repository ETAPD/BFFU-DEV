		# Tooltip: contract bonus per relations tier (hover icon or name)
		instantTextBoxType = {
			name = "jpmorgan_tooltip_fake"
			position = { x = @CORP_ICON_X y = 210 }
			maxwidth = 185
			maxHeight = 40
			pdx_tooltip = USA_corp_jpmorgan_tooltip
		}
		instantTextBoxType = {
			name = "jpmorgan_trust"
			position = { x = @TRUST_X y = 220 }
