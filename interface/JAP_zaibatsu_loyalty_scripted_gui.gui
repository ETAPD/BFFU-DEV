@HOUSE_ICON_X = 10
@HOUSE_NAME_X = 58
@LOYALTY_X    = 220
@EFFECT_X     = 320

# Row layout: icons are 64x64 native (Yasuda is up-scaled to match), so rows
# are spaced 74px apart (64 + 10 gap) and text is vertically centered on the
# icon (icon_y + 21) instead of merely offset 10px, which caused the
# misaligned/"slanted" look against the much taller icons.

guiTypes = {

	containerWindowType = {
		name = "JAP_zaibatsu_loyalty_decision_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 500 }

		# ── Column headers ──────────────────────────────────────────────────
		instantTextBoxType = {
			name = "loyalty_house_col_header"
			position = { x = @HOUSE_NAME_X y = 5 }
			font = "hoi_18mbs"
			text = "JAP_zaibatsu_loyalty_house_col_header"
			format = left
			maxHeight = 24
			maxwidth = 150
		}
		instantTextBoxType = {
			name = "loyalty_col_header"
			position = { x = @LOYALTY_X y = 5 }
			font = "hoi_18mbs"
			text = "JAP_zaibatsu_loyalty_col_header"
			format = center
			maxHeight = 24
			maxwidth = 90
		}
		instantTextBoxType = {
			name = "loyalty_effect_col_header"
			position = { x = @EFFECT_X y = 5 }
			font = "hoi_18mbs"
			text = "JAP_zaibatsu_loyalty_effect_col_header"
