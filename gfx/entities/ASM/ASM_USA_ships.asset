		event = { time = 0.2 node="turret_02" particle = "ship_fire_particle"  keep_particle = yes }		#mussleflash	
		event = { time = 0.35 node="turret_03" particle = "ship_fire_particle"  keep_particle = yes }		#mussleflash	
