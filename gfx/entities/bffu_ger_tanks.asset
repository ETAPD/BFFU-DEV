# BFFU custom German tank entities (models from 3d-workshop/scripts/tankgen)
# Hooked to chassis in gfx/interface/equipmentdesigner/graphic_db/00_tank_icons.txt

# Panzerkampfwagen IV Ausf. H, 1943 - ger_medium_tank_chassis_p4
# traced from MasterJVN's four-view drawing (Wikimedia Commons, CC BY 4.0) with 3d-workshop/scripts/tankgen/specs/ger_pz4h.py
entity = {
	name = "GER_medium_armor_pz4h_entity"
	pdxmesh = "GER_pz4h_mesh"

	state = { name = "idle"				animation = "idle"   animation_blend_time = 0.3 }
	state = { name = "move"				animation = "move"   animation_blend_time = 0.3
		event = { time = 0 node="right_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_tracks" particle = "tank_moving_tracks_particle"  keep_particle = no trigger_once = yes}
		event = { time = 0 node="right_tracks" particle = "tank_moving_tracks_particle"  keep_particle = no trigger_once = yes}
		event = { trigger_once = yes sound = { soundeffect = "tank_engine_medium_move" } }
	}
	state = { name = "retreat"			animation = "move"   animation_blend_time = 0.3
		event = { time = 0 node="right_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_tracks" particle = "tank_moving_tracks_particle"  keep_particle = no trigger_once = yes}
		event = { time = 0 node="right_tracks" particle = "tank_moving_tracks_particle"  keep_particle = no trigger_once = yes}
		event = { trigger_once = yes sound = { soundeffect = "tank_engine_medium_move" } }
	}
	state = { name = "attack"			animation = "attack" animation_blend_time = 0.3
		event = { time = 0 node="barrel" particle = "heavy_tank_attack_barrel_particle"  keep_particle = yes sound = { soundeffect = medium_armour_fire } }
		event = { time = 0 node="barrel" particle = "heavy_tank_attack_barrel_smoke_particle"  keep_particle = yes sound = { soundeffect = medium_armour_fire } }
	}
	state = { name = "defend"			animation = "attack" animation_blend_time = 0.3
		event = { time = 0 node="barrel" particle = "heavy_tank_attack_barrel_particle"  keep_particle = yes sound = { soundeffect = medium_armour_fire } }
		event = { time = 0 node="barrel" particle = "heavy_tank_attack_barrel_smoke_particle"  keep_particle = yes sound = { soundeffect = medium_armour_fire } }
	}
	state = { name = "support_attack"	animation = "attack" animation_blend_time = 0.3
		event = { time = 0 node="barrel" particle = "heavy_tank_attack_barrel_particle"  keep_particle = yes sound = { soundeffect = medium_armour_fire } }
		event = { time = 0 node="barrel" particle = "heavy_tank_attack_barrel_smoke_particle"  keep_particle = yes sound = { soundeffect = medium_armour_fire } }
	}
	state = { name = "training"			animation = "idle"   animation_blend_time = 0.3 animation_speed = 1.0
		event = { time = 0 node="right_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
	}

	# mesh is real size at 1.28 units/m (9 units long, like vanilla); 0.8 draws it at GEO's on-map size (~7 units), vanilla's 0.5 reads too small
	scale = 0.8

	game_data = {
		# shader scrolls track UVs at 2 x this per second; matches the wheel speed of the move animation (0.945 units/s, one texture tile per 0.48 m of track)
		texture_anim_speed = 0.769
	}
}

# Panzerkampfwagen IV Ausf. B/C, 1938-39 - ger_medium_tank_chassis_p4
# traced from MasterJVN's PzIV-011-BCD.jpg (Wikimedia Commons, CC BY 4.0) with 3d-workshop/scripts/tankgen/specs/ger_pz4b.py
entity = {
	name = "GER_medium_armor_pz4b_entity"
	pdxmesh = "GER_pz4b_mesh"

	state = { name = "idle"				animation = "idle"   animation_blend_time = 0.3 }
	state = { name = "move"				animation = "move"   animation_blend_time = 0.3
		event = { time = 0 node="right_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_tracks" particle = "tank_moving_tracks_particle"  keep_particle = no trigger_once = yes}
		event = { time = 0 node="right_tracks" particle = "tank_moving_tracks_particle"  keep_particle = no trigger_once = yes}
		event = { trigger_once = yes sound = { soundeffect = "tank_engine_medium_move" } }
